# ==============================================================================
# RetainIQ - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
!*.env.example

# ------------------------------------------------------------------------------
# 2. Node.js & Javascript Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build outputs
frontend/dist/
frontend/dist-ssr/
build/

# ------------------------------------------------------------------------------
# 3. Python Bytecode & Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / packaging
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Uploads, Temporary & Scratch Files
# ------------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
scratch/
tmp/
temp/
*.log

# ------------------------------------------------------------------------------
# 5. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
